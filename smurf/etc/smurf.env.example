SMURF_DATABASE_URL=postgres://smurf:smurf@127.0.0.1:5432/smurf?sslmode=disable
SMURF_REALM=smurf.local
SMURF_PUBLIC_IP=127.0.0.1
SMURF_RELAY_BIND=127.0.0.1
SMURF_RELAY_CONTROL=127.0.0.1:19000
SMURF_SIP_UDP=0.0.0.0:5060
SMURF_SIP_TCP=0.0.0.0:5060
SMURF_SIP_TLS=
SMURF_SIP_WSS=0.0.0.0:5081
SMURF_TLS_CERT=/etc/smurf/tls.crt
SMURF_TLS_KEY=/etc/smurf/tls.key
SMURF_API_LISTEN=0.0.0.0:5001
SMURF_JWT_SECRET=change-me-in-production
