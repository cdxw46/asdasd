# ============================================================================
# Piensa Dialer — copy to .env and fill in the secrets.
#   cp .env.example .env  &&  nano .env
# Never commit the real .env file (it is git-ignored).
# ============================================================================

# --- Telegram -------------------------------------------------------------
# Token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Optional allow-list of Telegram user IDs (comma separated). Leave empty to
# allow anyone who knows the bot. Send /start to the bot to learn your ID.
TELEGRAM_ALLOWED_USERS=

# --- Narayana SIP trunk ---------------------------------------------------
SIP_SERVER=rdx.narayana.im
SIP_LOGIN=372810444411282
# SIP password from the Narayana panel (kept secret, do not commit).
SIP_PASSWORD=
# Number shown to the people you call.
CALLER_ID=34680540787
# Public IP of the server, only needed if it is behind NAT (leave empty if not).
SIP_EXTERNAL_IP=

# --- Where pressing "1" transfers the call --------------------------------
# AGENT_MODE = sip    -> rings a softphone (Zoiper/PortSIP) registered to this
#                        server as AGENT_ENDPOINT (recommended, no PSTN cost).
# AGENT_MODE = number -> dials an external PSTN number via the trunk.
AGENT_MODE=sip
AGENT_ENDPOINT=agente1
# Only used when AGENT_MODE=number (E.164 without '+').
AGENT_NUMBER=

# SIP account your agents register in Zoiper/PortSIP (used by Asterisk).
# In the softphone: Server = <IP pública del servidor>, user = AGENT_SIP_USER,
# password = AGENT_SIP_PASSWORD. AGENT_SIP_USER must match AGENT_ENDPOINT.
AGENT_SIP_USER=agente1
AGENT_SIP_PASSWORD=

# --- ARI (internal Asterisk REST credentials, can stay as-is) -------------
ARI_USERNAME=piensa
ARI_PASSWORD=change-me-strong-password
ARI_APP=outbound
ARI_BASE_URL=http://127.0.0.1:8088
SIP_ENDPOINT=narayana-endpoint

# --- AMI (internal, used to reload PJSIP when agents change) --------------
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USER=piensa
AMI_PASSWORD=change-me-ami-password

# --- Agents (dynamic SIP users) + Zoiper QR provisioning ------------------
# Public base URL the agents' phones can reach to fetch their QR config.
# Use your server's public IP/host. Open PROVISION_PORT on the firewall.
PROVISION_BASE_URL=http://TU_IP_PUBLICA:8090
PROVISION_PORT=8090
# SIP host written into the agent's softphone profile (your public IP/host).
SIP_PUBLIC_HOST=TU_IP_PUBLICA

# --- Campaign behaviour ---------------------------------------------------
MAX_CONCURRENT_CALLS=5
CALL_TIMEOUT=30
IVR_MAX_REPEATS=2
IVR_INPUT_TIMEOUT=8
DEFAULT_COUNTRY_CODE=34

# --- Voice message --------------------------------------------------------
TTS_LANG=es
SOUND_NAME=piensa-aviso
# Leave empty to use the built-in Spanish message, or override it here.
MESSAGE_TEXT=
