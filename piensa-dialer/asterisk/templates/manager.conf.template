[general]
enabled = yes
port = 5038
bindaddr = 127.0.0.1
; With docker host networking the bot reaches AMI on 127.0.0.1. Never expose
; 5038 to the public internet.

[${AMI_USER}]
secret = ${AMI_PASSWORD}
deny = 0.0.0.0/0.0.0.0
permit = 127.0.0.1/255.255.255.255
read = system,command,reporting
write = system,command,reporting
