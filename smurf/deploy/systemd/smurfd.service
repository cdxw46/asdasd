[Unit]
Description=SMURF PBX daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=smurf
Group=smurf
ExecStart=/usr/local/bin/smurfd -config /etc/smurf/smurf.json
Restart=always
RestartSec=3
NoNewPrivileges=true
LimitNOFILE=65535
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
WorkingDirectory=/var/lib/smurf

[Install]
WantedBy=multi-user.target
