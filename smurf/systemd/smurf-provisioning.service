[Unit]
Description=SMURF Provisioning Service
After=network.target smurf-pbx-core.service
Wants=smurf-pbx-core.service

[Service]
Type=simple
User=smurf
Group=smurf
WorkingDirectory=/opt/smurf
Environment=PYTHONPATH=/opt/smurf
ExecStart=/opt/smurf-venv/bin/python /opt/smurf/services/provisioning/main.py --config /etc/smurf/config.yml
Restart=always
RestartSec=2
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
