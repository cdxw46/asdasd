{
  "log_level": "INFO",
  "sip": {
    "udp_bind": "0.0.0.0",
    "udp_port": 5060,
    "tcp_bind": "0.0.0.0",
    "tcp_port": 5060,
    "tls_bind": "0.0.0.0",
    "tls_port": 5061,
    "ws_bind": "0.0.0.0",
    "ws_port": 5062,
    "wss_bind": "0.0.0.0",
    "wss_port": 5063,
    "public_ip": null,
    "realm": "smurf.local",
    "user_agent": "SMURF-PBX/1.0",
    "registration_min_expires": 60,
    "registration_default_expires": 3600,
    "registration_max_expires": 7200
  },
  "rtp": {
    "bind": "0.0.0.0",
    "port_min": 16384,
    "port_max": 32767,
    "dscp": 46,
    "max_silence_ms": 30000,
    "enable_srtp": true
  },
  "web": {
    "bind": "0.0.0.0",
    "http_port": 5000,
    "https_port": 5001,
    "tls_cert": "/etc/smurf/certs/server.crt",
    "tls_key": "/etc/smurf/certs/server.key",
    "session_hours": 12
  },
  "storage": {
    "db_path": "/var/lib/smurf/smurf.db",
    "recordings_dir": "/var/lib/smurf/recordings",
    "voicemail_dir": "/var/lib/smurf/voicemail",
    "sounds_dir": "/var/lib/smurf/sounds",
    "provisioning_dir": "/var/lib/smurf/provisioning",
    "log_dir": "/var/log/smurf"
  },
  "security": {
    "fail2ban_window_sec": 300,
    "fail2ban_max_failures": 8,
    "fail2ban_ban_sec": 3600,
    "rate_limit_per_ip_pps": 200,
    "enable_2fa_admin": false
  }
}
