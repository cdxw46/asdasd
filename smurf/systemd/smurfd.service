[Unit]
Description=SMURF PBX (SIP, RTP, B2BUA, panel admin)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=smurf
Group=smurf
WorkingDirectory=/opt/smurf
Environment=PYTHONUNBUFFERED=1
Environment=SMURF_CONFIG=/etc/smurf/smurf.json
ExecStart=/opt/smurf/venv/bin/python -m smurfd.server
Restart=on-failure
RestartSec=3
LimitNOFILE=65535

# Permitir bind a puertos privilegiados sin sudo
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/smurf /var/log/smurf /etc/smurf

[Install]
WantedBy=multi-user.target
