# ============================================================
#  P1 Dialer - Configuracion (copia este fichero a .env)
# ============================================================
#  cp .env.example .env   y rellena los valores.
#  NO subas el .env real al repositorio (esta en .gitignore).
# ============================================================

# ---------- Telegram ----------
# Token del bot que te da @BotFather
TELEGRAM_BOT_TOKEN=123456789:CAMBIAME

# IDs de Telegram autorizados a usar el bot (separados por comas).
# Para saber tu ID, escribe a @userinfobot en Telegram.
# Si lo dejas vacio, NADIE podra usar el bot (por seguridad).
ALLOWED_USER_IDS=

# ---------- Trunk SIP (Narayana) ----------
SIP_SERVER=rdx.narayana.im
SIP_USERNAME=372810444411282
# La contraseña SIP. En la VPS metela aqui; en Cursor usa un Secret.
SIP_PASSWORD=CAMBIAME
# Caller ID que se muestra al llamar (numero que aparece en pantalla)
CALLER_ID=34680540787
# Codecs permitidos hacia el trunk
SIP_CODECS=alaw,ulaw

# Cifrado de medios: none | sdes | dtls
# Narayana muestra "DTLS-SRTP" en el panel, pero para un trunk SIP normal
# por UDP lo habitual es "none". Cambia a sdes/dtls solo si el proveedor
# lo exige y has configurado los certificados.
MEDIA_ENCRYPTION=none

# ---------- Logica de llamada ----------
# Numero al que se transfiere la llamada cuando el usuario pulsa 1.
# Formato internacional sin '+', ej: 34911234567
TRANSFER_NUMBER=34911234567

# Prefijo de pais por defecto para numeros que no lo lleven (sin '+').
# 34 = España. Un numero como "680540787" se convertira en "34680540787".
DEFAULT_COUNTRY_CODE=34

# Texto que dira el bot por voz (se genera con TTS si no hay audio propio).
PROMPT_TEXT=Hola. Le llamamos de seguridad. Hemos detectado actividad inusual en su cuenta. Si no ha sido usted, pulse uno para hablar con un agente.

# Texto breve antes de transferir
TRANSFER_TEXT=Un momento por favor, le paso con un agente.

# Llamadas simultaneas. OJO: el panel de Narayana muestra "Call Limit: 1",
# es decir tu trunk solo permite 1 llamada a la vez. Deja 1 salvo que
# amplies el limite con el proveedor.
MAX_CONCURRENT=1

# Segundos que suena antes de darla por no contestada
DIAL_TIMEOUT=30

# Segundos de espera de tecla tras el mensaje
DTMF_TIMEOUT=8

# ---------- Asterisk AMI (interno, no tocar normalmente) ----------
# Con docker-compose en network_mode host, el bot habla con Asterisk por
# localhost. Si usas red bridge, pon aqui "asterisk".
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USER=p1bot
AMI_SECRET=cambia-esta-clave-ami
