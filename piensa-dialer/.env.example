# ============================================================================
# Piensa Dialer — copy to .env and fill in the secrets.
#   cp .env.example .env  &&  nano .env
# Never commit the real .env file (it is git-ignored).
# ============================================================================

# --- Telegram -------------------------------------------------------------
# Token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Optional allow-list of Telegram user IDs (comma separated). Leave empty to
# allow anyone who knows the bot. Send /start to the bot to learn your ID.
TELEGRAM_ALLOWED_USERS=

# --- Narayana SIP trunk ---------------------------------------------------
SIP_SERVER=rdx.narayana.im
SIP_LOGIN=372810444411282
# SIP password from the Narayana panel (kept secret, do not commit).
SIP_PASSWORD=
# Number shown to the people you call.
CALLER_ID=34680540787
# Public IP of the server, only needed if it is behind NAT (leave empty if not).
SIP_EXTERNAL_IP=

# --- Where pressing "1" transfers the call --------------------------------
# Your agents' phone / switchboard number, E.164 without '+', e.g. 34911223344
AGENT_NUMBER=

# --- ARI (internal Asterisk REST credentials, can stay as-is) -------------
ARI_USERNAME=piensa
ARI_PASSWORD=change-me-strong-password
ARI_APP=outbound
ARI_BASE_URL=http://127.0.0.1:8088
SIP_ENDPOINT=narayana-endpoint

# --- Campaign behaviour ---------------------------------------------------
MAX_CONCURRENT_CALLS=5
CALL_TIMEOUT=30
IVR_MAX_REPEATS=2
IVR_INPUT_TIMEOUT=8
DEFAULT_COUNTRY_CODE=34

# --- Voice message --------------------------------------------------------
TTS_LANG=es
SOUND_NAME=piensa-aviso
# Leave empty to use the built-in Spanish message, or override it here.
MESSAGE_TEXT=
